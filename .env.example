# ── Keew IA ───────────────────────────────────────────────────────────────
# Banco de dados e login (Supabase → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Só no servidor: cria contas sem passar pelo e-mail do Supabase.
# Nunca use o prefixo NEXT_PUBLIC_ aqui — ele iria para o navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Motor de linguagem (opcional; sem ele a Keew responde o núcleo local)
KEEW_MODEL_BASE_URL=
KEEW_MODEL_API_KEY=
KEEW_MODEL_NAME=

# Tradução automática: a chave também pode ser gravada pelo próprio app,
# em POST /api/i18n/setup, e fica no banco em private.app_config.
# Definir este token fecha a rota depois que a chave já existe.
KEEW_SETUP_TOKEN=

# URL pública, usada em metadata e redirects de login
NEXT_PUBLIC_APP_URL=http://localhost:3000
